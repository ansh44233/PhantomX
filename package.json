{
  "name": "phantomx",
  "version": "1.0.0",
  "author": "Ansh",
  "description": "PhantomX - Next-Gen Streaming Experience by Ansh",
  "main": "public/electron.js",
  "private": true,
  "homepage": "./",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "@ghostery/adblocker-electron": "^2.11.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^0.27.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "customize-cra": "^1.0.0",
    "discord-rpc": "^4.0.1",
    "framer-motion": "^6.5.1",
    "lucide-react": "^0.542.0",
    "node-fetch": "^2.7.0",
    "react": "^18.2.0",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^18.2.0",
    "react-icons": "^4.4.0",
    "react-is": "^19.1.1",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "styled-components": "^5.3.5",
    "tailwind-merge": "^3.3.1",
    "timers-browserify": "^2.0.12",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@types/styled-components": "^5.1.26",
    "concurrently": "^7.2.2",
    "electron": "^19.1.9",
    "electron-builder": "^23.1.0",
    "wait-on": "^6.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-dev-safe": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron public/electron-no-discord.js\"",
    "electron-pack": "npm run build && electron-builder",
    "electron-pack-win": "npm run build && electron-builder --win",
    "electron-pack-mac": "npm run build && electron-builder --mac",
    "electron-pack-linux": "npm run build && electron-builder --linux",
    "preelectron-pack": "npm run build",
    "dist": "npm run build && electron-builder --publish=never",
    "postinstall": "electron-builder install-app-deps"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.ansh.phantomx",
    "productName": "PhantomX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/logo.png"
    ],
    "extraResources": [
      {
        "from": "public/logo.png",
        "to": "logo.png"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "public/logo.png"
    },
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PhantomX",
      "uninstallDisplayName": "PhantomX - Next-Gen Streaming Experience"
    },
    "publish": {
      "provider": "github",
      "owner": "your-username",
      "repo": "voidstream"
    }
  }
}